# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---- 数据 / 模型（大文件不进仓库）----
# 处理后的训练集、验证集和 48 题验证集题目可以入库。
# 评测结果在 outputs/，不要入库。
data/raw/
data/parquet/
data/*.parquet
data/*.jsonl
!data/*.example.jsonl
!data/eval_val_48.jsonl
models/
checkpoints/
*.bin
*.safetensors
*.gguf
*.faiss
*.index

# ---- 实验 / 日志 ----
# 训练日志入库；评测日志、检索日志、推理日志和 outputs/ 里的评测结果不入库。
logs/*
!logs/train*.log
outputs/
.swancb/
swanlog/
wandb/
ray/
/tmp/
*.log
!logs/train*.log

# ---- 密钥 / 本地配置 ----
.env
*token*.txt
api_keys.txt
configs/local/

# ---- IDE / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
